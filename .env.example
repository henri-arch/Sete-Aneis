# Copie para .env (local) ou configure na Vercel → Environment Variables.
# Nunca faça commit de .env — ele está no .gitignore.

# === IA Mestre (pelo menos uma) ===
# Prioridade: XAI_API_KEY → GROQ_API_KEY → OPENROUTER_API_KEY

# Groq (recomendado — gratuito): https://console.groq.com
GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# xAI (pago): https://console.x.ai
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.5

# OpenRouter (modelos :free): https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Timeout da chamada ao Mestre em ms (padrão 55000)
# GM_TIMEOUT_MS=55000

# Database (opcional — o jogo funciona só com localStorage)
# DATABASE_URL=postgres://...

# Código do modo Criador (só servidor — mínimo 4 caracteres (padrão do app: 1@+#))
CREATOR_ACCESS_CODE=1@+#

# Persistência (Neon Postgres)
# DATABASE_URL=postgres://...

# Auth (Better Auth / Grok broker). Sem isso, modo dev usa user local no PGLite.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=https://seu-app.vercel.app
# BETTER_AUTH_SECRET=gere-um-segredo-longo
